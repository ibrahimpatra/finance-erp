rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidUserId(userId) {
      return request.resource.data.userId == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /incomes/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if isOwner(userId);
      }
      match /expenses/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if isOwner(userId);
      }
      match /spentBy/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if isOwner(userId);
      }
      match /tags/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if isOwner(userId);
      }
      match /transfers/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if false;
      }
      match /ledger/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if false;
      }
      match /auditLogs/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if false;
      }
      match /monthlySnapshots/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /expenseTypes/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if isOwner(userId);
      }
      match /incomeSourceTypes/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if isOwner(userId);
      }
      match /currencies/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if isOwner(userId);
      }
      // ── Bank Accounts ────────────────────────────────────────
      match /bankAccounts/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow update, delete: if isOwner(userId);
      }
      // ── Expense Income Allocations (FIFO attribution — display only) ──
      // Allow delete so FIFO can clear and re-run; update blocked (immutable once set).
      // FIX (Phase 3): added resource.data.userId check — was missing, meaning
      // any authenticated user who somehow had a document ID could delete
      // another user's allocation record. Now matches the pattern used by
      // every other rule in this file.
      match /expenseIncomeAllocations/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserId(userId);
        allow delete: if isOwner(userId) && resource.data.userId == userId;
        allow update: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
